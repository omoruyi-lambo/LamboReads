# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL (set to your Vercel production URL after deployment)
NEXT_PUBLIC_SITE_URL=https://your-vercel-domain.vercel.app

# Book provider cache and sync settings
BOOK_PROVIDER_CACHE_SECONDS=3600
BOOK_PROVIDER_TIMEOUT_MS=8000
BOOK_SYNC_SECRET=your-random-secret

# Optional: direct database connection (not required for most setups)
DATABASE_URL=https://your-project.supabase.co
